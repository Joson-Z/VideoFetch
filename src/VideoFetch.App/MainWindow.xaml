<Window x:Class="VideoFetch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoFetch.App"
        mc:Ignorable="d"
        Title="VideoFetch"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Border Width="520"
                Padding="32"
                Background="White"
                BorderBrush="#D9DEE8"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="VideoFetch"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,14,0,0"
                           Text="项目骨架已就绪，视频解析与下载功能正在接入。"
                           FontSize="15"
                           Foreground="#586174"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
